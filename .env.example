# Copia este archivo como .env para configurar LEVELIFE.
# Clave de IA: sin ella, Vela aparece sin conectar y el juego lo indica.
GEMINI_API_KEY=
LEVELIFE_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LEVELIFE_PORT=5173
# Actívalo si sirves el juego por HTTPS.
LEVELIFE_SECURE_COOKIES=0
